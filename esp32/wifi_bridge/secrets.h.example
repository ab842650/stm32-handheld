/* Copy to secrets.h and fill in your own values:
 *
 *     cp secrets.h.example secrets.h
 *
 * secrets.h is gitignored; this template is the file that gets committed.
 * Never put a real token in the template.
 */
#ifndef SECRETS_H
#define SECRETS_H

/* The ESP32 is 2.4 GHz only; a 5 GHz SSID will not connect. */
const char* WIFI_SSID = "your-wifi-ssid";
const char* WIFI_PASS = "your-wifi-password";

/* Developer Portal -> your App -> Bot -> Reset Token.
 * This is a credential: anyone holding it controls the bot. Reset it if it leaks. */
const char* DC_TOKEN = "";

/* Discord Settings -> Advanced -> Developer Mode on,
 * then right-click the channel -> Copy Channel ID. */
const char* DC_CHANNEL = "";

#endif /* SECRETS_H */
