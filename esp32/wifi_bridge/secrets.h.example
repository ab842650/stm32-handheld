/* 複製這個檔成 secrets.h，填入自己的值。
 *
 *     cp secrets.h.example secrets.h
 *
 * secrets.h 在 .gitignore 裡，不會進版控。這個 .example 才會。
 * 千萬不要把真的 token 填進 .example。
 */
#ifndef SECRETS_H
#define SECRETS_H

/* WiFi —— ESP32 只吃 2.4GHz，5GHz 的 SSID 連不上 */
const char* WIFI_SSID = "your-wifi-ssid";
const char* WIFI_PASS = "your-wifi-password";

/* Discord bot token
 * Developer Portal → 你的 App → Bot → Reset Token
 * 這是等同密碼的憑證：拿到的人可以用你的 bot 做任何事。外流就馬上 Reset。 */
const char* DC_TOKEN = "";

/* 頻道 ID
 * Discord 設定 → 進階 → 開發者模式 ON → 右鍵頻道 → 複製頻道 ID */
const char* DC_CHANNEL = "";

#endif /* SECRETS_H */
